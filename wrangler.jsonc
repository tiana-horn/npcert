{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "npcert",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "LEADS" }
  ],
  "observability": { "enabled": true }
}
