---
import Base from '../layouts/Base.astro';
import { routes, links, site } from '../config/site';

const shortcuts = [
  { title: 'Class schedule', text: 'Days and times for every program', href: routes.schedule },
  { title: 'WhatsApp community', text: 'Reminders and peer support', href: links.whatsapp },
  { title: 'Extend my review', text: 'Upgrade packages for returning students', href: `${routes.pmhnp}#plans` },
];
---
<Base
  title="Student Login | NP Certification Academy"
  description="Log in to your NP Certification Academy online classroom for classes, slides and recordings."
  crumb="Student login"
>
  <section class="bg-surface section-y-80 px-6">
    <div class="max-w-[560px] mx-auto bg-white rounded-3xl p-[clamp(28px,5vw,48px)] shadow-[0_8px_28px_rgba(11,31,58,0.08)] flex flex-col gap-5 text-center items-center">
      <span class="size-14 rounded-[14px] bg-teal-tint flex items-center justify-center">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0E6E6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
      </span>
      <h1 class="m-0 text-[clamp(30px,4vw,40px)] leading-[1.15] font-extrabold">Student login</h1>
      <p class="m-0 text-[17px] leading-relaxed text-body-muted">Your classes, slides and recordings are in your online classroom.</p>
      <a href={links.classroom} class="btn btn-primary w-full text-[17px] min-h-[52px] rounded-xl" data-track="cta_click" data-location="login" data-label="Log in to my classroom">Log in to my classroom</a>
      <span class="text-sm text-fine-print">Trouble logging in? Email <a href={`mailto:${site.email}`}>{site.email}</a> or call <a href={`tel:${site.phone.tel}`} data-track="tel_click" data-location="login">{site.phone.display}</a>.</span>
    </div>
  </section>

  <section class="px-6 pt-14 md:pt-16 pb-14 md:pb-20">
    <div class="max-w-[1000px] mx-auto grid grid-cols-[repeat(auto-fit,minmax(min(240px,100%),1fr))] gap-4">
      {shortcuts.map((s) => (
        <a href={s.href} class="no-underline !text-ink border border-card-border rounded-2xl p-[22px] flex flex-col gap-1.5 hover:border-teal transition-colors">
          <b class="text-[17px]">{s.title}</b>
          <span class="text-sm text-body-muted">{s.text}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
