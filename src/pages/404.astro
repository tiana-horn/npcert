---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | NP Certification Academy">
  <section class="min-h-[60vh] flex items-center justify-center px-6 py-24 bg-surface">
    <div class="max-w-[560px] text-center flex flex-col gap-5 items-center">
      <span class="eyebrow">Page not found</span>
      <h1 class="m-0 text-[clamp(30px,3.6vw,42px)] leading-[1.15] font-extrabold">We couldn't find that page.</h1>
      <p class="m-0 text-lg text-body-muted">It may have moved when we updated the site.</p>
      <a href="/#exams" class="btn btn-primary text-[17px]">Find my review</a>
    </div>
  </section>
</Base>
