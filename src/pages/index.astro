---
import Base from '../layouts/Base.astro';
import TrialForm from '../components/TrialForm.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import Check from '../components/Check.astro';
import {
  site, hero, stats, googleReviews, photos, routes, exams, formats, testimonials, sisterOrgs, faqs, summit,
} from '../config/site';
import { catalog } from '../config/catalog';
import { homeSchema } from '../config/schema';

const reviewCount = googleReviews.count.toLocaleString('en-US');
const proof = [
  { value: stats.yearsExperience, label: 'clinical & teaching experience' },
  googleReviews.rating
    ? { value: `${googleReviews.rating}★`, label: `from ${reviewCount} Google reviews`, href: googleReviews.url }
    : { value: reviewCount, label: 'Google reviews from students', href: googleReviews.url },
  stats.nursesTaught && { value: stats.nursesTaught, label: 'nurses & NPs taught' },
  stats.passRate && { value: stats.passRate.value, label: `first-attempt pass rate, ${stats.passRate.cohortYear} cohort*` },
  { value: '4 styles', label: 'visual, auditory, reading/writing, hands-on' },
].filter(Boolean) as { value: string; label: string; href?: string | null }[];

const steps = [
  { n: '01', title: 'Join a live cohort', body: 'Two live Zoom classes a week with Dr. K. Ask questions in real time — live or hybrid schedule.' },
  { n: '02', title: 'Practice like the real exam', body: 'Board-style question bank and practice exams with rationales, mapped to the test outline.' },
  { n: '03', title: 'Get mentored to the finish', body: 'Personal check-ins, a peer community, and a 3-week upgrade if you need more time.' },
];

const styles = [
  { title: 'Visual', body: 'Diagrams, charts and drug-class maps' },
  { title: 'Auditory', body: 'Live lectures and recorded replays' },
  { title: 'Reading / writing', body: 'Workbooks and outline-mapped notes' },
  { title: 'Hands-on', body: 'Case studies and timed practice' },
];

const visibleFaqs = faqs.filter((f) => f.a) as { q: string; a: string }[];
---
<Base active="home" schema={homeSchema()}>
    <!-- Hero -->
    <section class="bg-surface" data-hero>
      <div class="container-page pt-12 pb-14 md:pt-[72px] md:pb-20 flex flex-wrap gap-12 items-center">
        <div class="flex-[999_1_520px] min-w-0 flex flex-col gap-6">
          <span class="self-start bg-teal-tint text-teal-dark font-bold text-[13px] tracking-[0.04em] uppercase px-3.5 py-2 rounded-full">{hero.badge}</span>
          <h1 class="m-0 text-[clamp(36px,5vw,58px)] leading-[1.08] font-extrabold tracking-[-0.02em]">{hero.h1}</h1>
          <p class="m-0 text-[19px] leading-relaxed text-body-muted max-w-[600px]">{hero.sub}</p>
          <div class="flex flex-wrap gap-3">
            <a href={hero.primaryCta.href} class="btn btn-primary text-[17px] px-[26px] min-h-[52px] rounded-xl" data-track="cta_click" data-location="hero" data-label={hero.primaryCta.label}>{hero.primaryCta.label}</a>
            <a href={hero.secondaryCta.href} class="btn btn-secondary text-[17px] px-6 min-h-[52px] rounded-xl" data-track="cta_click" data-location="hero" data-label={hero.secondaryCta.label}>{hero.secondaryCta.label}</a>
          </div>
          <ul class="mt-2 p-0 list-none flex flex-wrap gap-x-6 gap-y-2.5 text-[15px] text-body-muted font-medium">
            <li class="flex gap-2 items-center"><Check />CNE approved by Kansas State Board of Nursing</li>
            <li class="flex gap-2 items-center"><Check />Live classes, not just recordings</li>
            <li class="flex gap-2 items-center"><Check />ADD/ADHD-friendly support</li>
          </ul>
        </div>

        <div class="flex-[1_1_360px] min-w-0 flex flex-col gap-4">
          {photos.hero ? (
            <img src={photos.hero.src} alt={photos.hero.alt} width={photos.hero.width} height={photos.hero.height} fetchpriority="high" decoding="async" class="w-full aspect-[4/4.2] object-cover rounded-[20px] bg-placeholder" />
          ) : (
            <div class="rounded-[20px] aspect-[4/4.2] bg-teal flex items-center justify-center" aria-hidden="true">
              <span class="text-white/90 font-extrabold text-[clamp(72px,10vw,128px)] tracking-[-0.03em]">Dr. K</span>
            </div>
          )}
          <div class="bg-white rounded-2xl px-[22px] py-5 shadow-[0_8px_28px_rgba(11,31,58,0.10)] flex flex-col gap-1.5 -mt-[72px] mx-5 relative">
            <span class="font-extrabold text-[17px]">Dr. Kehinde Elisha</span>
            <span class="text-sm text-body-muted">FNP, PMHNP-BC, MSc Info · Legal Nurse Consultant</span>
            <span class="text-sm text-teal-dark font-semibold">Founder &amp; lead instructor</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Proof strip -->
    <section class="border-b border-divider" aria-label="At a glance">
      <div class="container-page py-9 grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-6">
        {proof.map((p) => {
          const inner = <><span class="text-[34px] font-extrabold text-teal">{p.value}</span><span class="text-[15px] text-body-muted">{p.label}</span></>;
          return p.href
            ? <a href={p.href} class="flex flex-col gap-1 no-underline hover:[&>span:last-child]:underline" rel="noopener">{inner}</a>
            : <div class="flex flex-col gap-1">{inner}</div>;
        })}
      </div>
    </section>

    <ReviewCarousel />

    <!-- Exam picker -->
    <section id="exams" class="section-y px-6">
      <div class="max-w-[1200px] mx-auto flex flex-col gap-10">
        <div class="flex flex-col gap-3 max-w-[720px]">
          <span class="eyebrow">Step 1 · Pick your exam</span>
          <h2 class="h2">Which board are you preparing for?</h2>
          <p class="m-0 text-lg leading-relaxed text-body-muted">Every review is built around the current ANCC or AANP test content outline.</p>
        </div>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(270px,1fr))] gap-5">
          {exams.map((e) => (
            <a
              href={e.href}
              class:list={[
                'no-underline !text-ink rounded-[18px] p-7 flex flex-col gap-3.5 bg-white transition-shadow hover:shadow-[0_8px_28px_rgba(11,31,58,0.10)]',
                e.featured ? 'border-2 border-teal' : 'border border-card-border',
              ]}
              data-track="exam_card_click"
              data-track-name={e.id}
            >
              {e.featured && <span class="self-start bg-teal text-white text-xs font-bold px-2.5 py-[5px] rounded-md">MOST POPULAR</span>}
              <span class="text-2xl font-extrabold">{e.name}</span>
              <span class="text-[15px] text-body-muted leading-[1.55]">{e.blurb}</span>
              {e.price && <span class="text-[15px] text-body-muted">From <b class="text-ink">{e.price}</b></span>}
              <span class="mt-auto font-bold text-teal-dark text-base">{e.linkLabel} →</span>
            </a>
          ))}
        </div>
        <div class="flex flex-wrap gap-x-7 gap-y-3 text-base font-semibold">
          <span class="text-body-muted font-medium">Exam in under 3 weeks?</span>
          <a href={routes.lmr}>Last Minute Review →</a>
          <a href={routes.qbank}>Question banks{catalog.qbankFrom && ` from ${catalog.qbankFrom}`} →</a>
          <a href={routes.books}>Books &amp; self-paced courses →</a>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="bg-ink text-white section-y px-6 on-dark">
      <div class="max-w-[1200px] mx-auto flex flex-col gap-11">
        <h2 class="h2 max-w-[720px]">A clear path from enrollment to exam day</h2>
        <ol class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-7 list-none m-0 p-0">
          {steps.map((s) => (
            <li class="flex flex-col gap-3 border-t-[3px] border-amber pt-5">
              <span class="text-[15px] font-bold text-amber">{s.n}</span>
              <span class="text-[21px] font-bold">{s.title}</span>
              <span class="text-base leading-relaxed text-muted-on-dark">{s.body}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Learning styles -->
    <section class="section-y px-6">
      <div class="max-w-[1200px] mx-auto flex flex-wrap gap-14 items-center">
        <div class="flex-[1_1_420px] min-w-0 flex flex-col gap-[18px]">
          <span class="eyebrow">Feeling anxious about your exam?</span>
          <h2 class="h2">Taught the way you actually learn</h2>
          <p class="m-0 text-lg leading-[1.65] text-body-muted">If a past attempt, test anxiety or ADD/ADHD has made studying feel impossible, you're not behind — you've been taught the wrong way. Every lesson is built for all four learning styles, and students with ADD/ADHD get personalized pacing and study plans.</p>
          <a href="#trial" class="self-start font-bold text-[17px]" data-track="cta_click" data-location="learning_styles" data-label="Sit in on a free class">Sit in on a free class first →</a>
        </div>
        <div class="flex-[1_1_420px] min-w-0 grid grid-cols-2 gap-4">
          {styles.map((s) => (
            <div class="bg-surface rounded-2xl p-5 sm:p-6 flex flex-col gap-2"><span class="font-bold text-lg">{s.title}</span><span class="text-[15px] text-body-muted leading-normal">{s.body}</span></div>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials (hidden until real, permissioned quotes exist) -->
    {testimonials.length > 0 && (
      <section class="bg-surface section-y px-6">
        <div class="max-w-[1200px] mx-auto flex flex-col gap-10">
          <h2 class="h2">Nurse practitioners who passed</h2>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-5">
            {testimonials.map((t) => (
              <figure class="m-0 bg-white rounded-[18px] p-7 flex flex-col gap-[18px]">
                <blockquote class="m-0 text-[17px] leading-relaxed">“{t.quote}”</blockquote>
                <figcaption class="text-sm text-body-muted"><b class="text-ink">{t.name}, {t.credential}</b><br />{t.result}</figcaption>
              </figure>
            ))}
          </div>
          {stats.passRate && (
            <p class="m-0 text-[13px] text-fine-print">*Pass rate based on {stats.passRate.reportedN} students who reported results from the {stats.passRate.cohortYear} cohort. Individual results vary.</p>
          )}
        </div>
      </section>
    )}

    <!-- Formats & pricing -->
    <section id="formats" class:list={['section-y px-6', testimonials.length === 0 && 'bg-surface']}>
      <div class="max-w-[1200px] mx-auto flex flex-col gap-10">
        <div class="flex flex-col gap-3 max-w-[720px]">
          <span class="eyebrow">Step 2 · Choose how you learn</span>
          <h2 class="h2">Review formats</h2>
        </div>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(270px,1fr))] gap-5 items-stretch">
          {formats.map((f) => (
            <div class:list={['rounded-[18px] p-[30px] flex flex-col gap-4', f.featured ? 'border-2 border-teal bg-teal-wash' : 'border border-card-border bg-white']}>
              <h3 class="m-0 text-xl font-extrabold">{f.name}</h3>
              {f.price && <span class="text-4xl font-extrabold">{f.price}{f.priceNote && <span class="text-base font-semibold text-body-muted"> {f.priceNote}</span>}</span>}
              <ul class="m-0 pl-5 text-[15px] leading-[1.9] text-body-muted grow">
                {f.bullets.map((b) => <li>{b}</li>)}
              </ul>
              <a
                href={f.cta.href}
                class:list={['btn text-base py-3.5', f.variant === 'primary' && 'btn-primary', f.variant === 'teal' && 'btn-teal', f.variant === 'secondary' && 'btn-secondary']}
                data-track="checkout_start"
                data-track-name={f.id}
                data-location="formats"
                data-label={f.cta.label}
              >{f.cta.label}</a>
            </div>
          ))}
        </div>
        <p class="m-0 text-[15px] text-body-muted">Returning student with an expired review? <a href={catalog.pmhnpUpgrade.href!} class="font-bold" data-track="checkout_start" data-track-name={catalog.pmhnpUpgrade.name} data-location="formats">Add the 3-week PMHNP Upgrade Package →</a></p>
      </div>
    </section>

    <!-- About -->
    <section id="about" class:list={['section-y px-6', testimonials.length > 0 && 'bg-surface']}>
      <div class="max-w-[1200px] mx-auto flex flex-wrap gap-14 items-start">
        {photos.portrait ? (
          <img src={photos.portrait.src} alt={photos.portrait.alt} width={photos.portrait.width} height={photos.portrait.height} loading="lazy" decoding="async" class="flex-[1_1_320px] min-w-0 w-full aspect-[4/5] object-cover rounded-[20px] bg-placeholder" />
        ) : (
          <div class="flex-[1_1_320px] min-w-0 rounded-[20px] aspect-[4/5] bg-ink flex flex-col justify-end p-8 gap-2 on-dark" aria-hidden="true">
            <span class="text-amber text-sm font-bold uppercase tracking-[0.06em]">18+ years in practice</span>
            <span class="text-white text-2xl font-extrabold leading-tight">Duke · NewYork-Presbyterian · Montefiore · Johns Hopkins</span>
          </div>
        )}
        <div class="flex-[999_1_520px] min-w-0 flex flex-col gap-5">
          <span class="eyebrow">Meet your instructor</span>
          <h2 class="h2">Dr. Kehinde Elisha, FNP, PMHNP-BC</h2>
          <p class="m-0 text-lg leading-[1.65] text-body-muted">Dr. K has spent more than 18 years in practice, including over 12 years caring for critically ill patients in the ICUs of Duke University Hospital, NewYork-Presbyterian, Montefiore Medical Center and Johns Hopkins. She teaches the way she practices: clinical reasoning first, memorization second.</p>
          <p class="m-0 text-lg leading-[1.65] text-body-muted">She is also a Legal Nurse Consultant and holds an MSc in Informatics.</p>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-3 mt-2">
            {sisterOrgs.map((o) => {
              const cls = 'rounded-xl px-[18px] py-4 text-[15px] border border-divider bg-white block no-underline !text-ink';
              const inner = <><b>{o.name}</b><br /><span class="text-body-muted">{o.tagline}</span></>;
              return o.href ? <a href={o.href} class={cls + ' hover:border-teal'} rel="noopener">{inner}</a> : <div class={cls}>{inner}</div>;
            })}
          </div>
        </div>
      </div>
    </section>

    <TrialForm />

    <!-- FAQ -->
    <section class="px-6 pb-14 md:pb-[88px]">
      <div class="max-w-[820px] mx-auto flex flex-col gap-3">
        <h2 class="m-0 mb-5 text-[clamp(28px,3.4vw,38px)] font-extrabold">Common questions</h2>
        {visibleFaqs.map((f) => (
          <details class="group border-b border-divider py-[18px]">
            <summary class="text-lg font-bold flex justify-between gap-4 items-start">
              {f.q}
              <svg class="shrink-0 mt-1 transition-transform group-open:rotate-45" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0E6E6B" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="mt-3 mb-0 text-base leading-relaxed text-body-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Summit band -->
    <section class="bg-teal-tint py-10 px-6">
      <div class="max-w-[1200px] mx-auto flex flex-wrap gap-x-8 gap-y-4 items-center justify-between">
        <div class="flex flex-col gap-1"><span class="font-extrabold text-xl">{summit.name}</span><span class="text-[15px] text-teal-deep">{summit.detail}</span></div>
        <a href={summit.href} class="btn btn-dark text-[15px]" data-track="cta_click" data-location="summit" data-label="Get summit details">Get summit details</a>
      </div>
    </section>
  <!-- Mobile sticky bar: appears after the hero -->
  <div slot="after" class="xl:hidden fixed inset-x-0 bottom-0 z-30 bg-white border-t border-divider px-4 py-3 flex gap-3 translate-y-full transition-transform data-[visible=true]:translate-y-0 shadow-[0_-6px_20px_rgba(11,31,58,0.08)]" data-sticky-bar aria-hidden="true">
    <a href="#exams" class="btn btn-primary flex-1 text-base" tabindex="-1" data-track="cta_click" data-location="sticky_bar" data-label="Choose your exam">Choose your exam</a>
    <a href={`tel:${site.phone.tel}`} class="btn btn-secondary px-0 w-12" tabindex="-1" aria-label={`Call ${site.phone.display}`} data-track="tel_click" data-location="sticky_bar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    </a>
  </div>
</Base>
