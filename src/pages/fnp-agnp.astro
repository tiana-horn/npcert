---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import PlanCard from '../components/PlanCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { catalog as c } from '../config/catalog';
import { routes, links } from '../config/site';
import { courseSchema } from '../config/schema';

const description =
  'FNP and AGNP board review for ANCC and AANP: 8-week live Comprehensive course, 4-week Self-Paced, or a 2-day Last Minute Intensive. Practice exams with rationales.';

const pickers = [
  { quote: 'I need content <b>and</b> questions, with a teacher.', plan: 'Comprehensive', href: '#comprehensive' },
  { quote: "My schedule is unpredictable. I'll study on my own time.", plan: 'Self-paced', href: '#selfpaced' },
  { quote: "I just graduated or I'm retesting, and my exam is soon.", plan: 'Fast track', href: '#fasttrack' },
];
const domains = ['Assessment', 'Diagnosis', 'Planning', 'Implementation', 'Evaluation'];
const numerals = ['I', 'II', 'III', 'IV', 'V'];
---
<Base
  title="FNP & AGNP Board Review — ANCC & AANP | NP Certification Academy"
  description={description}
  active="fnp"
  crumb="FNP & AGNP review"
  schema={[courseSchema('FNP / AGNP Board Review (ANCC & AANP)', description, routes.fnp, [c.fnpComprehensive, c.fnpSelfPaced, c.fnpIntensive])]}
>
  <PageHero
    crumb="FNP & AGNP review"
    badge="FNP · AGNP · ANCC & AANP"
    title="FNP and AGNP board review — live, self-paced, or fast track."
    sub="Every option follows the ANCC and AANP test content outlines and includes full-length practice exams with rationales."
    ctas={[
      { label: 'Compare FNP/AGNP plans', href: '#plans' },
      { label: 'Free FNP/AGNP trial class', href: links.freeTrialFnp },
    ]}
  />

  <section class="section-y-80 px-6">
    <div class="max-w-[1200px] mx-auto flex flex-col gap-7">
      <h2 class="m-0 text-[clamp(28px,3.4vw,40px)] leading-[1.15] font-extrabold">Which plan fits you?</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-4">
        {pickers.map((p) => (
          <a href={p.href} class="no-underline !text-ink border border-card-border rounded-2xl p-6 flex flex-col gap-2 hover:border-teal transition-colors">
            <span class="text-[15px] text-body-muted" set:html={`“${p.quote}”`} />
            <span class="font-extrabold text-lg text-teal-dark">{p.plan} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="plans" class="bg-surface section-y-80 px-6 scroll-mt-24">
    <div class="max-w-[1200px] mx-auto grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-5 items-stretch">
      <PlanCard
        id="comprehensive"
        product={c.fnpComprehensive}
        title="Comprehensive"
        meta="8 weeks · live on Zoom · 50+ hours"
        bullets={['Last Minute Review + 500 questions included', 'Full-length ANCC-style practice exams', 'Slides, quizzes and an exit exam', 'Weekly Q&amp;A and test-taking strategy', 'Canvas discussion boards', '15 CEUs in pharmacology']}
        cta="Reserve my seat"
        featured
        location="fnp_plans"
      />
      <PlanCard
        id="selfpaced"
        product={c.fnpSelfPaced}
        title="Self-Paced"
        meta="4 weeks of access · full question set"
        bullets={['Organized, high-yield modules', 'Practice exams with detailed rationales', 'Slides, pharm charts and review notes', 'Elimination and exam strategy training', 'Canvas community support', '10 CEUs in pharmacology']}
        cta="Start self-paced"
        location="fnp_plans"
      />
      <PlanCard
        id="fasttrack"
        product={c.fnpIntensive}
        title="Last Minute Intensive"
        meta="2 days · live with an instructor present"
        bullets={['Last Minute Review + 200 questions', 'For recent grads and repeat test-takers', 'Covered in exam-domain order']}
        note="Out of school 2+ years? Choose Comprehensive."
        cta="Book the intensive"
        location="fnp_plans"
      />
    </div>
  </section>

  <section class="section-y-80 px-6">
    <div class="max-w-[1200px] mx-auto flex flex-col gap-7">
      <SectionHead eyebrow="What we cover" title="Mapped to the test content outline" />
      <ol class="grid grid-cols-[repeat(auto-fit,minmax(min(190px,100%),1fr))] gap-3 list-none m-0 p-0">
        {domains.map((d, i) => (
          <li class="bg-surface rounded-[14px] p-5"><span class="text-[13px] font-bold text-teal-dark">{numerals[i]}</span><br /><b class="text-[17px]">{d}</b></li>
        ))}
      </ol>
      <p class="m-0 text-[15px] text-body-muted">Plus leadership and pharmacology throughout. Class times: <a href={routes.schedule} class="font-bold">see the schedule →</a></p>
    </div>
  </section>

  <CtaBand
    flushTop
    title="Try an FNP/AGNP class free"
    text="See Dr. K teach before you enroll."
    cta={{ label: 'Save my free seat', href: links.freeTrialFnp }}
    location="fnp_cta"
  />
</Base>
