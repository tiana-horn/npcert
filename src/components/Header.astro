---
import { site, cohort, links } from '../config/site';

const navLinks = [
  { label: 'Exam reviews', href: '#exams' },
  { label: 'Schedule & pricing', href: '#formats' },
  { label: 'Question bank', href: links.questionBank },
  { label: 'CE & mentorship', href: links.ceMentorship },
  { label: 'About Dr. K', href: '#about' },
];
---
<div class="bg-ink text-white text-sm on-dark">
  <div class="container-page py-2.5 flex flex-wrap gap-x-6 gap-y-2 justify-between items-center">
    {cohort.nextCohortStart ? (
      <span class="font-semibold">
        Next {cohort.track} live cohort starts {cohort.nextCohortStart}
        {cohort.seatsLeft != null && <> · <span class="text-amber">{cohort.seatsLeft} seats left</span></>}
      </span>
    ) : (
      <span></span>
    )}
    <span class="flex flex-wrap gap-5">
      <a href={`tel:${site.phone.tel}`} class="!text-white no-underline hover:underline" data-track="tel_click" data-location="utility_bar">Call {site.phone.display}</a>
      <a href={links.studentLogin} class="!text-white no-underline hover:underline">Student login</a>
    </span>
  </div>
</div>

<header class="sticky top-0 z-40 bg-white border-b border-divider" data-header>
  <nav class="container-page py-3.5 md:py-[18px] flex items-center justify-between gap-4 lg:gap-8" aria-label="Main">
    <a href="#top" class="flex items-center gap-3 no-underline !text-ink min-w-0">
      <span class="shrink-0 size-10 rounded-[10px] bg-teal text-white flex items-center justify-center font-extrabold text-base" aria-hidden="true">NP</span>
      <span class="flex flex-col leading-[1.15] min-w-0">
        <span class="font-extrabold text-[17px] sm:text-lg">{site.name}</span>
        <span class="text-xs text-fine-print font-medium hidden sm:block">Board review by Dr. Kehinde Elisha</span>
      </span>
    </a>

    <ul class="hidden lg:flex flex-wrap gap-x-7 gap-y-2 text-[15px] font-semibold list-none m-0 p-0">
      {navLinks.map((l) => <li><a href={l.href} class="!text-ink no-underline hover:!text-teal">{l.label}</a></li>)}
    </ul>

    <div class="flex items-center gap-2 shrink-0">
      <a href="#exams" class="btn btn-primary text-[15px] px-5 hidden sm:inline-flex" data-track="cta_click" data-location="header" data-label="Find my review">Find my review</a>
      <button
        type="button"
        class="lg:hidden inline-flex items-center justify-center size-11 rounded-[10px] border border-card-border bg-white cursor-pointer"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-toggle
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true" data-icon-open><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true" data-icon-close hidden><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="lg:hidden border-t border-divider bg-white" hidden data-menu>
    <ul class="container-page py-4 flex flex-col list-none m-0">
      {navLinks.map((l) => (
        <li><a href={l.href} class="block py-3 text-lg font-semibold !text-ink no-underline border-b border-divider">{l.label}</a></li>
      ))}
      <li><a href={`tel:${site.phone.tel}`} class="block py-3 text-lg font-semibold no-underline" data-track="tel_click" data-location="mobile_menu">Call {site.phone.display}</a></li>
    </ul>
  </div>
</header>
