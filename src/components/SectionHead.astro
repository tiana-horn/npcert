---
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  dark?: boolean;
}
const { eyebrow, title, sub, dark = false } = Astro.props;
---
<div class="flex flex-col gap-2.5 max-w-[720px]">
  {eyebrow && <span class:list={['eyebrow', dark && '!text-amber']}>{eyebrow}</span>}
  <h2 class="m-0 text-[clamp(28px,3.4vw,40px)] leading-[1.15] font-extrabold">{title}</h2>
  {sub && <p class:list={['m-0 text-[17px]', dark ? 'text-muted-on-dark' : 'text-body-muted']}>{sub}</p>}
</div>
